# Server Configuration
PORT=3000
HOST=localhost

# Security
SESSION_SECRET=change-this-to-random-string-at-least-32-chars
BCRYPT_ROUNDS=12
MAX_SESSION_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=100

# Proxy Settings
PROXY_TIMEOUT=30000
DNS_SERVERS=8.8.8.8,1.1.1.1,208.67.222.222
DNS_CACHE_TTL=300000

# YouTube (yt-dlp is optional - InnerTube is used by default)
YTDLP_PATH=yt-dlp

# Features
ENABLE_FINGERPRINTING=true
ENABLE_YOUTUBE=true
ENABLE_GAMES=true

# Paths
DATA_PATH=./data
EXTENSIONS_PATH=./extensions
PUBLIC_PATH=./public